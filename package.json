{
  "name": "eventmanager-mobile",
  "version": "2.0.0",
  "private": true,
  "description": "EventManager - Ionic Angular mobile app reconstructed for portfolio use",
  "scripts": {
    "start": "ng serve",
    "serve": "ionic serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "cap:sync": "npx cap sync",
    "android:add": "npx cap add android && node scripts/ensure-android-min-sdk.mjs",
    "android:sync": "npm run build:prod && npx cap sync android",
    "android:open": "npx cap open android",
    "android": "npm run android:sync && npm run android:open",
    "android:fix-sdk": "node scripts/ensure-android-min-sdk.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/barcode-scanner": "^3.1.2",
    "@capacitor/core": "^8.5.1",
    "@ionic/angular": "8.8.19",
    "ionicons": "^8.0.13",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.5.1",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/cli": "^7.2.1",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
